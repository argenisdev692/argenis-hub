# ---- Security response headers (config/security.php) ----
# Consumed by Shared\Infrastructure\Http\Middleware\SecurityHeaders.
# PERMISSIONS_POLICY=... lists features the browser must deny to this origin.
PERMISSIONS_POLICY="camera=(), geolocation=(), microphone=(), payment=(), usb=(), interest-cohort=()"

# HSTS is only sent on HTTPS requests, so plain-HTTP local dev is never pinned.
# Leave HSTS_INCLUDE_SUBDOMAINS=false unless EVERY subdomain of the deploy host
# is served over HTTPS — a browser that pins one broken subdomain cannot undo it.
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false

# ---- Object storage (Cloudflare R2) ----
FILESYSTEM_CLOUD=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=r2-bucket
R2_PUBLIC_BASE_URL=
R2_ENDPOINT=
R2_URL=
R2_USE_PATH_STYLE_ENDPOINT=false
# Extra browser origins for R2 CORS. APP_URL (config('app.url')) is always included.
# Declared ONCE on purpose: dotenv keeps the first occurrence of a key, so a second
# R2_CORS_EXTRA_ORIGINS further down this file was silently discarded and the extra
# origins never reached the deploy.
R2_CORS_EXTRA_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8000,http://localhost,https://*.argenis.dev,https://argenis-hub-production.up.railway.app


AUTH_LOCKOUT_MAX_ATTEMPTS=10
AUTH_LOCKOUT_DECAY_MINUTES=15
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_OTP_EXPIRES_IN_MINUTES=30
AUTH_OTP_RESEND_PER_MINUTE=1
AUTH_OTP_RESEND_PER_HOUR=5
AUTH_TRUSTED_DEVICE_DAYS=30
AUTH_SESSION_IDLE_MINUTES=1440
AUTH_PRIVILEGED_SESSION_IDLE_MINUTES=60


BREVO_MAIL_SCHEME=smtp
BREVO_MAIL_HOST=smtp-relay.brevo.com
BREVO_MAIL_PORT=587
BREVO_MAIL_USERNAME=     # Brevo SMTP login, e.g. 9xxxxx@smtp-brevo.com
