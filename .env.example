ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-6
OPENAI_TEXT_MODEL=gpt-5.4
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_API_KEY=
OPENAI_URL=
OPENAI_STORE=
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_API_KEY=
AZURE_OPENAI_URL=
