# ---- AI providers ----
# Select one: gemini | anthropic | openai
# Prompt-cache observability and long-lived TTL. Leave these SET: an empty
# value is not "use the default", it disables the usage log and silently
# downgrades Anthropic cache blocks from 1h to the 5-minute TTL.
AI_PROMPT_CACHE_LOG_USAGE=true
AI_PROMPT_CACHE_LONG_TTL=1h
AI_PROVIDER=openai
AI_EVALUATOR_PROVIDER=anthropic
AI_IMAGE_PROVIDER=gemini
AI_FAILOVER_ORDER=anthropic,gemini
AI_PROMPT_CACHE=true
AI_EMBEDDINGS_CACHE=true
SPEECH_SYNTHESIZER=elevenlabs
SPEECH_TIMEOUT=30
GEMINI_API_KEY=
GEMINI_URL=https://generativelanguage.googleapis.com
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_TEXT_MODEL=claude-sonnet-5
OPENAI_TEXT_MODEL=gpt-5.4
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1

OPENAI_STORE=
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_API_KEY=
AZURE_OPENAI_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_IMAGE_DEPLOYMENT=
AZURE_OPENAI_STORE=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
VOYAGEAI_API_KEY=
JINA_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
 # ── V2 · Whisper transcription ────────────────────────────────
OPENAI_API_KEY=sk-...
# `whisper-1` is not a default, it is a requirement: it is the only model that
# returns word timings, and every cut in this module resolves against them.
# OpenAI retires it on 2027-02-26 — the replacement path is another provider.
OPENAI_WHISPER_MODEL=whisper-1
# Per-attempt budget for one upload. 20 min covers the module's 90-minute
# ceiling at ~4.5x real-time. It is NOT retried on timeout: a request that ran
# out of time returns the same verdict next attempt, so the queue's own
# #[Backoff] handles a genuine second go instead.
OPENAI_WHISPER_TIMEOUT=1200

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Rachel
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---- Tavily (research / web search) ----
TAVILY_API_KEY=
TAVILY_SEARCH_URL=https://api.tavily.com/search
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5

