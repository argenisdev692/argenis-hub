SECURITY_CSP_IMG_SRC=


CONTEXT7_API_KEY=""
CONTEXT7_BASE_URL="https://context7.com/api/v2"
CONTEXT7_MAX_SNIPPETS="5"

CRM_API_TOKEN=

# ── V3 · Gemini analysis ──────────────────────────────────────
          
VIDEO_EDIT_AI_PROVIDER=gemini
VIDEO_EDIT_AI_MODEL=gemini-3.8-flash
VIDEO_EDIT_AI_TIMEOUT=300
VIDEO_EDIT_AI_MIN_CONFIDENCE=0.8
VIDEO_EDIT_SPEECH_LANGUAGE=es
VIDEO_EDIT_QUEUE_RETRY_AFTER=3900

# ── Cut edges ─────────────────────────────────────────────────
# How far a cut may grow to swallow the leftovers at its own seam: the
# conjunction the speaker had already committed to ("...de Veralux Group y…")
# and any word Whisper heard cut off mid-syllable ("o co-"). Only words that
# can never end a sentence are ever taken. 0 disables the behaviour.
VIDEO_EDIT_EDGE_ABSORB_MS=400

# ── Room tone (de-reverb / denoise) ────────────────────────────
# Off by default: the reduction is audible on clean speech, so it is a
# deliberate choice rather than a sensible default. It subtracts the steady
# hiss and rumble of a bad room; a long reverb tail is a room, not a noise
# floor, and survives this. NR_DB=0 leaves the audio untouched.
#
# IMPORTANT with an OBS recording: OBS already runs RNNoise on the mic, so this
# is a SECOND denoiser. Keep NR_DB low (6-12). Pushing it higher takes energy
# out of speech that is already clean and sounds metallic/"underwater".
VIDEO_EDIT_ROOM_TONE=true
VIDEO_EDIT_ROOM_TONE_NR_DB=12
VIDEO_EDIT_ROOM_TONE_NF_DB=-25
VIDEO_EDIT_ROOM_TONE_HIGHPASS_HZ=80

# ── Loudness (EBU R128 delivery target) ────────────────────────
# The one audio stage the capture chain does NOT already cover: OBS has no
# loudness filter and the guide disables Windows enhancements, so nothing in
# the capture path targets a delivery level. -16 LUFS / -1.5 dBTP are the
# podcast values student platforms normalise to; the peak leaves headroom for
# the platform's own encoder. This is what rescues quiet words after denoising.
VIDEO_EDIT_LOUDNORM=true
VIDEO_EDIT_LOUDNORM_I=-16.0
VIDEO_EDIT_LOUDNORM_TP=-1.5
VIDEO_EDIT_LOUDNORM_LRA=11.0

# ── Delivery format (client spec: 1080p, >=30 fps, H.264 .mp4, 48 kHz) ──
# The last two output settings that used to be hardcoded literals in
# config/video-edit.php, meaning no deployment could influence them.
# VIDEO_EDIT_AUDIO_CHANNELS: set 1 when the capture chain records MONO, which is
# what guia_audio_obs.md 2.1 specifies for OBS. The render then keeps the source
# layout instead of upmixing (`FilterGraphBuilder::channelLayout` and the `-ac` on
# the encode both read this), so the delivered audio matches what was recorded.
# Set 2 only if the client requires stereo.
# VIDEO_EDIT_AUDIO_SAMPLE_RATE: keep 48000. Do NOT confuse it with the 16 kHz in
# video-edit.speech.audio_sample_rate — that is the Whisper upload, a separate
# mono 32 kbps stage that only has to be intelligible to the model.
VIDEO_EDIT_AUDIO_CHANNELS=1
VIDEO_EDIT_AUDIO_SAMPLE_RATE=48000

# ── Join seams ─────────────────────────────────────────────────
# OBSERVACIONES round 2 (05:22): the splice was audible as a splice. FADE_MS
# ramps the level at each cut edge; AIR_MS then holds that much room tone before
# the next cut. Picture holds its last frame for the same air, so the lip sync
# never drifts. This is deliberately NOT a crossfade — acrossfade overlaps the
# clips, which shortens the audio against the picture and smears two syllables
# into one phaser artefact. AIR_MS=0 leaves a hard join with a soft fade.
VIDEO_EDIT_JOIN_FADE_MS=40
VIDEO_EDIT_JOIN_AIR_MS=80

# ── Capture chain (FFmpeg equivalents of the OBS filters) ──────
# ALL OFF BY DEFAULT, and that is the correct setting for a recording made with
# the OBS + Fifine setup in guia_audio_obs.md: OBS already applied RNNoise, a
# 3:1 compressor, a 4:1 expander and a limiter to that file. Repeating any of
# them here is double processing and makes the audio worse.
#
# Turn these on ONLY for a source that was NOT processed in OBS (a camera, a
# phone, a raw screen capture). The values mirror the guide's chain exactly.
#
# RNNOISE needs a model file; OBS ships one but OBS cannot export it. RNNoise's
# own is sh.rnnn. Leave MODEL empty and the stage is skipped rather than
# failing the render.
VIDEO_EDIT_VOICE_RNNOISE=false
VIDEO_EDIT_VOICE_RNNOISE_MODEL=
VIDEO_EDIT_VOICE_RNNOISE_MIX=1.0

# OBS Compressor: 3:1 above -18 dB, 6 ms attack, 100 ms release, +3 dB make-up.
VIDEO_EDIT_VOICE_COMPRESSOR=false
VIDEO_EDIT_VOICE_COMP_THRESHOLD=-18.0
VIDEO_EDIT_VOICE_COMP_RATIO=3.0
VIDEO_EDIT_VOICE_COMP_ATTACK=6.0
VIDEO_EDIT_VOICE_COMP_RELEASE=100.0
VIDEO_EDIT_VOICE_COMP_MAKEUP=3.0
VIDEO_EDIT_VOICE_COMP_KNEE=2.82843

# OBS Expander, approximated with FFmpeg's agate (which is a gate, not a true
# expander — hence the high ratio plus a deep RANGE). A threshold this low is
# gentle; raising it towards -35 dB tames keyboard clicks but starts clipping
# the start of quiet words, which is the guide's own troubleshooting row.
VIDEO_EDIT_VOICE_EXPANDER=false
VIDEO_EDIT_VOICE_EXP_THRESHOLD=-40.0
VIDEO_EDIT_VOICE_EXP_RATIO=4.0
VIDEO_EDIT_VOICE_EXP_ATTACK=10.0
VIDEO_EDIT_VOICE_EXP_RELEASE=100.0
VIDEO_EDIT_VOICE_EXP_RANGE=-40.0

# OBS Limiter at -3 dB. Runs before loudnorm, which is correct: the limiter
# catches peaks in the source, loudnorm sets the delivery level, and loudnorm's
# own true-peak ceiling keeps the result under control afterwards.
VIDEO_EDIT_VOICE_LIMITER=false
VIDEO_EDIT_VOICE_LIMIT_CEILING=-3.0
VIDEO_EDIT_VOICE_LIMIT_ATTACK=5.0
VIDEO_EDIT_VOICE_LIMIT_RELEASE=60.0

# ── FFmpeg binaries ───────────────────────────────────────────
FFMPEG_BINARIES=C:/ffmpeg/bin/ffmpeg.exe
FFPROBE_BINARIES=C:/ffmpeg/bin/ffprobe.exe
FFMPEG_TIMEOUT=3600
FFMPEG_THREADS=false
FFMPEG_TEMPORARY_FILES_ROOT= 

# ── Queue (Redis / Upstash) ───────────────────────────────────
VIDEO_EDIT_QUEUE_CONNECTION=video-edits
VIDEO_EDIT_QUEUE=video-edits
VIDEO_EDIT_REDIS_CONNECTION=queue
VIDEO_EDIT_QUEUE_RETRY_AFTER=3900
VIDEO_EDIT_PROBE_TIMEOUT=120
VIDEO_EDIT_SCREEN_ACTIVITY=true
VIDEO_EDIT_BREATHS=true

RAILPACK_DEPLOY_APT_PACKAGES=ffmpeg
RAILPACK_PHP_EXTENSIONS=redis,pcntl,zip,gd,exif