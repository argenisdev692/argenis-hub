 # ── V2 · Whisper transcription ────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_WHISPER_TIMEOUT=600

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Rachel
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---- Tavily (research / web search) ----
TAVILY_API_KEY=
TAVILY_SEARCH_URL=https://api.tavily.com/search
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5

# ---- LeadScout (spec 003-lead-scout) ----
# Monthly budgets in EUR (T006, US-8). Never logged, only limits + spent.
LEAD_SCOUT_SEARCH_BUDGET_EUR=8
LEAD_SCOUT_EXTRACTION_BUDGET_EUR=15
LEAD_SCOUT_AI_BUDGET_EUR=7
# Default AI provider/model per purpose, from the closed catalog in
# config/lead-scout.php (T006, US-10). Fallbacks optional.
LEAD_SCOUT_AI_EXTRACTION_PROVIDER=gemini
LEAD_SCOUT_AI_EXTRACTION_MODEL=gemini-3.7-flash
LEAD_SCOUT_AI_EXTRACTION_FALLBACK_PROVIDER=anthropic
LEAD_SCOUT_AI_EXTRACTION_FALLBACK_MODEL=claude-sonnet-5
LEAD_SCOUT_AI_DRAFTING_PROVIDER=anthropic
LEAD_SCOUT_AI_DRAFTING_MODEL=claude-sonnet-5
LEAD_SCOUT_AI_DRAFTING_FALLBACK_PROVIDER=gemini
LEAD_SCOUT_AI_DRAFTING_FALLBACK_MODEL=gemini-3.7-flash
# Local PostgreSQL for the Pest `pgsql` group (T003). Never Supabase.
PG_TEST_HOST=127.0.0.1
PG_TEST_PORT=5432
PG_TEST_DATABASE=argenis_hub_testing
PG_TEST_USERNAME=postgres
PG_TEST_PASSWORD=
# Art. 14 notice + opt-out line on every draft (FR-26).
LEAD_SCOUT_PRIVACY_EMAIL=privacidad@argenis.dev
LEAD_SCOUT_PRIVACY_URL=https://argenis.dev/privacy#prospeccion
# Weekly scout_* pg_dump (T077, mandatory on Supabase Free). Folder outside
# the repo — confirm the path with the operator (RoPA, OP-10). Retention: 4.
LEAD_SCOUT_BACKUP_DIR=
LEAD_SCOUT_PG_DUMP=pg_dump
# Job-board feeds and fetch endpoints (empty keeps the config default)
LEAD_SCOUT_ARBEITNOW_URL=https://www.arbeitnow.com/api/job-board-api
LEAD_SCOUT_FIRECRAWL_V2_URL=https://api.firecrawl.dev/v2
LEAD_SCOUT_LARAJOBS_FEED=
LEAD_SCOUT_REMOTIVE_FEED=
LEAD_SCOUT_WWR_FEED=

# CV ATS Job Studio — monthly spend ceilings per user (EUR)
CV_STUDIO_LLM_BUDGET_EUR=5
CV_STUDIO_SEARCH_BUDGET_EUR=5
CV_STUDIO_EXTRACTION_BUDGET_EUR=5

# Conservative per-call cost estimates (EUR) charged against those budgets
CV_STUDIO_LLM_CALL_ESTIMATE_EUR=0.02
CV_STUDIO_FIRECRAWL_SCRAPE_EUR=0.01

# ---- Product packages storage prefix ----
PRODUCT_PACKAGE_STORAGE_DISK=r2
PRODUCT_PACKAGE_STORAGE_DIRECTORY=ai/product-packages

# ---- Products (Module 4 â€” content generator) ----
# Model used per topic by the generation pipeline (config/products.php).
PRODUCTS_AI_MODEL=gpt-4.1-mini

# ---- Resume Studio (Module 2 â€” AiResumeStudio) ----
CV_STUDIO_SCHEDULE_TIME=09:00
CV_STUDIO_SCHEDULE_TIMEZONE=Europe/Lisbon
CV_STUDIO_DEEP_EXTRACT_TOP_N=3
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1
FIRECRAWL_TIMEOUT=30
FIRECRAWL_MAX_AGE=172800000
# Optional — enriches GitHub portfolio step (never logged)
GITHUB_TOKEN=
# Optional — ITJobs.pt read-only key (requested by email at itjobs.pt/api)
ITJOBS_API_KEY=
# Optional — Adzuna app_id + key (~1,000 calls/month free)
ADZUNA_APP_ID=
ADZUNA_API_KEY=

APP_NAME_DESCRIPTION_TITLE=AI-PoweredWorkspaceforCreatorsandEducators

GOOGLE_CALENDAR_AUTH_PROFILE=oauth
