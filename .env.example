VIDEO_EDIT_QUEUE_RETRY_AFTER=3900
VIDEO_EDIT_PROBE_TIMEOUT=120

RAILPACK_DEPLOY_APT_PACKAGES=ffmpeg
RAILPACK_PHP_EXTENSIONS=redis,pcntl