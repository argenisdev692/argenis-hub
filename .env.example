APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379



MAIL_ADAPTER=resend
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- Object storage (Cloudflare R2) ----
FILESYSTEM_CLOUD=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=r2-bucket
R2_PUBLIC_BASE_URL=
R2_ENDPOINT=
R2_URL=
R2_USE_PATH_STYLE_ENDPOINT=false
# Extra browser origins for R2 CORS. APP_URL (config('app.url')) is always included.
R2_CORS_EXTRA_ORIGINS=


AUTH_LOCKOUT_MAX_ATTEMPTS=10
AUTH_LOCKOUT_DECAY_MINUTES=15
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_OTP_EXPIRES_IN_MINUTES=30
AUTH_OTP_RESEND_PER_MINUTE=1
AUTH_OTP_RESEND_PER_HOUR=5
AUTH_TRUSTED_DEVICE_DAYS=30
AUTH_SESSION_IDLE_MINUTES=1440
AUTH_PRIVILEGED_SESSION_IDLE_MINUTES=60


BREVO_MAIL_SCHEME=smtp
BREVO_MAIL_HOST=smtp-relay.brevo.com
BREVO_MAIL_PORT=587
BREVO_MAIL_USERNAME=     # Brevo SMTP login, e.g. 9xxxxx@smtp-brevo.com
BREVO_MAIL_PASSWORD=

RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=no-reply@example.com

GOOGLE_MAPS_API_KEY=

# ---- AI providers ----
# Select one: gemini | anthropic | openai
AI_PROVIDER=openai
