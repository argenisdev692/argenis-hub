{
    "openapi": "3.1.0",
    "info": {
        "title": "ArgenisHub",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "http://localhost:8000/api"
        }
    ],
    "security": [
        {
            "http": []
        }
    ],
    "paths": {
        "/user": {
            "get": {
                "responses": {
                    "200": {
                        "description": "`User`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/activity-logs": {
            "get": {
                "operationId": "activity-logs.index",
                "description": "Returns a paginated, filtered list of audit-trail entries, newest first.\nAccepts `search`, `event`, `log_name`, `causer_id`, `date_from`, `date_to`,\n`sort_direction` and `per_page` (capped at 100 to bound resource\nconsumption \u2014 OWASP API4).",
                "summary": "List activity log entries",
                "tags": [
                    "ActivityLogApi"
                ],
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "maxLength": 255
                        }
                    },
                    {
                        "name": "date_from",
                        "in": "query",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "date_to",
                        "in": "query",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "event",
                        "in": "query",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "maxLength": 255
                        }
                    },
                    {
                        "name": "log_name",
                        "in": "query",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "maxLength": 255
                        }
                    },
                    {
                        "name": "causer_id",
                        "in": "query",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "maxLength": 255
                        }
                    },
                    {
                        "name": "sort_direction",
                        "in": "query",
                        "schema": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "enum": [
                                "asc",
                                "desc",
                                null
                            ]
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": [
                                "integer",
                                "null"
                            ],
                            "minimum": 1,
                            "maximum": 100
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LengthAwarePaginator"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "An error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview.",
                                            "examples": [
                                                ""
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/activity-logs/{id}": {
            "get": {
                "operationId": "activity-logs.show",
                "description": "Returns a single audit-trail entry with its full property and\nattribute-change payloads.",
                "summary": "Show an activity log entry",
                "tags": [
                    "ActivityLogApi"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/ActivityLogDetailData"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "An error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview.",
                                            "examples": [
                                                ""
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "operationId": "auth.login",
                "description": "Every rejection below answers with the SAME message and status, so the\nendpoint never becomes an account-enumeration oracle (OWASP \u00a72).",
                "summary": "Exchange credentials for a bearer token",
                "tags": [
                    "AuthApi"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ApiLoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "token": {
                                            "$ref": "#/components/schemas/ApiTokenData"
                                        },
                                        "user": {
                                            "$ref": "#/components/schemas/AuthenticatedUserData"
                                        }
                                    },
                                    "required": [
                                        "token",
                                        "user"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                },
                "security": []
            }
        },
        "/auth/refresh": {
            "post": {
                "operationId": "auth.refresh",
                "description": "The presented token is destroyed and replaced, so a leaked bearer stops\nworking as soon as the legitimate client refreshes. The device name is\ncarried over, which is what makes the rotation idempotent per device.",
                "summary": "Rotate the caller's own token",
                "tags": [
                    "AuthApi"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "token": {
                                            "$ref": "#/components/schemas/ApiTokenData"
                                        },
                                        "user": {
                                            "$ref": "#/components/schemas/AuthenticatedUserData"
                                        }
                                    },
                                    "required": [
                                        "token",
                                        "user"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "operationId": "auth.logout",
                "summary": "Revoke the presented token (sign out this device only)",
                "tags": [
                    "AuthApi"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "const": "Signed out."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/auth/me": {
            "get": {
                "operationId": "auth.me",
                "summary": "The authenticated identity behind the presented token",
                "tags": [
                    "AuthApi"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "user": {
                                            "$ref": "#/components/schemas/AuthenticatedUserData"
                                        }
                                    },
                                    "required": [
                                        "user"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/public/company": {
            "get": {
                "operationId": "public.company",
                "description": "Returns the trading name, brand-mark URLs, every social profile and the\nstreet address. Responds 404 until the installation has been seeded.",
                "summary": "Get the public company profile",
                "tags": [
                    "PublicCompany"
                ],
                "responses": {
                    "200": {
                        "description": "`PublicCompanyData`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PublicCompanyData"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/public/services": {
            "get": {
                "operationId": "public.services",
                "summary": "List the active services, in display order",
                "tags": [
                    "PublicService"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        }
    },
    "components": {
        "securitySchemes": {
            "http": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "ActivityLogDetailData": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "log_name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "description": {
                        "type": "string"
                    },
                    "event": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "subject_type": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "subject_id": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "causer_id": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "causer_type": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "causer_label": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "properties": {
                        "type": [
                            "array",
                            "null"
                        ],
                        "items": {
                            "type": "string"
                        }
                    },
                    "attribute_changes": {
                        "type": [
                            "array",
                            "null"
                        ],
                        "items": {
                            "type": "string"
                        }
                    },
                    "created_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "updated_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "id",
                    "description"
                ],
                "title": "ActivityLogDetailData"
            },
            "ApiLoginRequest": {
                "type": "object",
                "description": "Credentials for `POST /api/auth/login`.\n\n`device_name` names the token so it can be rotated and revoked per device\n(\"Pixel 8\", \"iPad\"). It is attacker-controlled text that ends up in a token\nlabel, so it is length-capped and never interpolated anywhere but the label.\n\n`code` carries the TOTP or recovery code and is required only when the\naccount has confirmed two-factor authentication \u2014 enforced in the controller,\nbecause demanding it up front would leak which accounts have 2FA enabled.",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string"
                    },
                    "device_name": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "code": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 64
                    }
                },
                "required": [
                    "email",
                    "password",
                    "device_name"
                ],
                "title": "ApiLoginRequest"
            },
            "ApiTokenData": {
                "type": "object",
                "properties": {
                    "access_token": {
                        "type": "string"
                    },
                    "token_type": {
                        "type": "string"
                    },
                    "expires_at": {
                        "type": "string"
                    },
                    "abilities": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "access_token",
                    "token_type",
                    "expires_at",
                    "abilities"
                ],
                "title": "ApiTokenData"
            },
            "AuthenticatedUserData": {
                "type": "object",
                "properties": {
                    "uuid": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "email_verified_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "two_factor_enabled": {
                        "type": "boolean"
                    },
                    "roles": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "permissions": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "uuid",
                    "name",
                    "email",
                    "two_factor_enabled",
                    "roles",
                    "permissions"
                ],
                "title": "AuthenticatedUserData"
            },
            "LengthAwarePaginator": {
                "type": "object",
                "properties": {
                    "current_page": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "first_page_url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "from": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 1
                    },
                    "last_page_url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "last_page": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "links": {
                        "type": "array",
                        "description": "Generated paginator links.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "url": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "label": {
                                    "type": "string"
                                },
                                "active": {
                                    "type": "boolean"
                                }
                            },
                            "required": [
                                "url",
                                "label",
                                "active"
                            ]
                        }
                    },
                    "next_page_url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "path": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Base path for paginator generated URLs."
                    },
                    "per_page": {
                        "type": "integer",
                        "description": "Number of items shown per page.",
                        "minimum": 0
                    },
                    "prev_page_url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "to": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "Number of the last item in the slice.",
                        "minimum": 1
                    },
                    "total": {
                        "type": "integer",
                        "description": "Total number of items being paginated.",
                        "minimum": 0
                    }
                },
                "required": [
                    "current_page",
                    "data",
                    "first_page_url",
                    "from",
                    "last_page_url",
                    "last_page",
                    "links",
                    "next_page_url",
                    "path",
                    "per_page",
                    "prev_page_url",
                    "to",
                    "total"
                ],
                "title": "LengthAwarePaginator"
            },
            "PublicCompanyData": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "legal_name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "description": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "website": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "email": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "phone": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "logos": {
                        "$ref": "#/components/schemas/CompanyLogosData"
                    },
                    "socials": {
                        "$ref": "#/components/schemas/CompanySocialsData"
                    },
                    "address": {
                        "$ref": "#/components/schemas/CompanyAddressData"
                    }
                },
                "required": [
                    "name",
                    "logos",
                    "socials",
                    "address"
                ],
                "title": "PublicCompanyData"
            },
            "User": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "uuid": {
                        "type": "string"
                    },
                    "first_name": {
                        "type": "string"
                    },
                    "last_name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "username": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "email": {
                        "type": "string"
                    },
                    "email_verified_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "two_factor_confirmed_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "password_changed_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "must_change_password": {
                        "type": "boolean"
                    },
                    "invited_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "invited_by": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "phone": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "date_of_birth": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "address": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "address_2": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "zip_code": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "city": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "state": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "country": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "country_code": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "latitude": {
                        "type": [
                            "number",
                            "null"
                        ]
                    },
                    "longitude": {
                        "type": [
                            "number",
                            "null"
                        ]
                    },
                    "gender": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "profile_photo_path": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "terms_and_conditions": {
                        "type": "boolean"
                    },
                    "created_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "deleted_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "locked_until": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    }
                },
                "required": [
                    "id",
                    "uuid",
                    "first_name",
                    "last_name",
                    "username",
                    "email",
                    "email_verified_at",
                    "two_factor_confirmed_at",
                    "password_changed_at",
                    "must_change_password",
                    "invited_at",
                    "invited_by",
                    "phone",
                    "date_of_birth",
                    "address",
                    "address_2",
                    "zip_code",
                    "city",
                    "state",
                    "country",
                    "country_code",
                    "latitude",
                    "longitude",
                    "gender",
                    "profile_photo_path",
                    "terms_and_conditions",
                    "created_at",
                    "updated_at",
                    "deleted_at",
                    "locked_until"
                ],
                "title": "User"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}