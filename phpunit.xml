<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <directory>src/Modules/*/Tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <directory>src/Modules/*/Tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!--
            Outbound research / speech providers are pinned OFF for the whole
            suite. TavilyResearchAdapter and ElevenLabsSpeechAdapter both
            early-return on an empty key, which is exactly the offline
            behaviour the AI-assist tests assume. Before `services.tavily` and
            `services.elevenlabs` existed in config/services.php these resolved
            to null and short-circuited by accident; now that they are wired,
            leaving them unset here would make every test run issue real,
            billed HTTP calls using the developer's own .env key.
        -->
        <env name="TAVILY_API_KEY" value=""/>
        <env name="ELEVENLABS_API_KEY" value=""/>
        <!--
            Object storage is pinned to inert placeholders for the same reason as
            the API keys above: the suite must never depend on the developer's own
            .env, and must never reach the network.

            Presigning (StoragePort::temporaryUploadUrl, hit by every Video Edit
            store request) is pure local HMAC, so placeholder credentials make the
            real R2StorageAdapter path work offline. Without them the AWS SDK finds
            no credentials in CI, walks its provider chain to the EC2 instance
            metadata service at 169.254.169.254, and throws "Error retrieving
            credentials from the instance profile metadata service" - which failed
            every Video Edit creation test while passing on a developer machine,
            because .env carries the real R2 keys.

            The endpoint must be set too, not just the keys: R2ConfigurationTest
            asserts the signing endpoint and the public URL are different hosts,
            and .env.example ships both empty, so that comparison was null !== null.

            AWS_EC2_METADATA_DISABLED is the hard stop: any path that still reaches
            the default provider chain now fails fast instead of hanging on the
            metadata probe.
        -->
        <env name="AWS_EC2_METADATA_DISABLED" value="true"/>
        <env name="AWS_ACCESS_KEY_ID" value="testing"/>
        <env name="AWS_SECRET_ACCESS_KEY" value="testing"/>
        <env name="AWS_DEFAULT_REGION" value="us-east-1"/>
        <env name="AWS_BUCKET" value="testing-bucket"/>
        <env name="R2_ACCESS_KEY_ID" value="testing"/>
        <env name="R2_SECRET_ACCESS_KEY" value="testing"/>
        <env name="R2_DEFAULT_REGION" value="auto"/>
        <env name="R2_BUCKET" value="testing-bucket"/>
        <env name="R2_ENDPOINT" value="https://testing-account.r2.cloudflarestorage.com"/>
        <env name="R2_URL" value="https://pub-testing-account.r2.dev"/>
        <env name="R2_PUBLIC_BASE_URL" value="https://pub-testing-account.r2.dev"/>
        <env name="R2_USE_PATH_STYLE_ENDPOINT" value="true"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Video Edits dispatches on its own Redis (Upstash) connection; keep tests off the network. -->
        <env name="VIDEO_EDIT_QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
