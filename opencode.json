{
    "$schema": "https://opencode.ai/config.json",
    "instructions": [
        "AGENTS.md",
        ".opencode/rules/rules.mdc"
    ],
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "codebase-memory": {
            "type": "local",
            "command": ["npx", "-y", "codebase-memory-mcp"],
            "enabled": true
        }

    }
}